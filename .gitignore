# Dependencies
/node_modules/
/vendor/

# Environment files and local credentials
.env
.env.*
.env[0-9]*
!.env.example
!.env.*.example
/auth.json
/.aws/

# Generated frontend assets (standard and backup document roots)
/build/
/hot
/public/build/
/public/hot
/public/storage
/excel/build/

# Laravel runtime data and uploaded media
/storage/*
!/storage/.gitignore
/bootstrap/cache/*
!/bootstrap/cache/.gitignore
/uploads/
/public/uploads/

# Test artifacts
/.phpunit.cache/
.phpunit.result.cache
/coverage/

# Package manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local development tools
/Homestead.json
/Homestead.yaml
/.fleet/
/.idea/
/.vscode/

# OS-generated files
.DS_Store
Thumbs.db
